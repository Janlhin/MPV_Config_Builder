#!/bin/sh
# 提交信息门禁（L2 本地门禁层：git commit）。
#
# 这个文件里**不放判断规则** —— 规则在 tools/verify.py 的 commitmsg 子命令里。
# 钩子只做一件事实上的事：把 git 给的提交信息文件路径转发过去。
#
# 为什么是 sh 薄壳、不是 .ps1：Git for Windows 用 sh 跑钩子，钩子文件名没有
# 扩展名，PowerShell 的 -File 不接受无扩展名文件（实测踩过，见
# docs/平台与写入约定.md 的 Q-002）。所以薄壳保持 sh，业务逻辑一律留在 .py。
# 钩子必须 LF 行尾（CRLF 会让 sh 解析失败）。
#
# 生效方式（与 pre-commit 共用一次配置）：
#     git config core.hooksPath .githooks
#
# ⚠ 本机 py -3 会退出 103（AGENTS.md §2.2），所以用 python。

if ! command -v python >/dev/null 2>&1; then
    echo "[commit-msg] 门禁跑不起来：找不到 python（AGENTS.md 2.2：用 python，不是 py -3）" >&2
    exit 1
fi

exec python tools/verify.py commitmsg "$1"
